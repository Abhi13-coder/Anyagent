<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0E0E12">

    <!-- Compact top bar: folder / providers / shell setup, replaces 3 full-width buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:weightSum="3">

        <Button
            android:id="@+id/btnPickFolder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:textSize="10sp"
            android:text="Folder" />

        <Button
            android:id="@+id/btnProviders"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:textSize="10sp"
            android:text="Models" />

        <Button
            android:id="@+id/btnSetupShell"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="10sp"
            android:text="Shell setup" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvFolder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="No folder selected"
        android:textColor="#7A7A85"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/tvActiveCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:text="0 active models"
        android:textColor="#7A7A85"
        android:textSize="10sp" />

    <!-- Chat log, replaces the old single tvLog TextView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="4dp" />

    <CheckBox
        android:id="@+id/cbContinue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="#A0A0AE"
        android:textSize="11sp"
        android:text="Continue previous conversation (reply to a follow-up)" />

    <!-- Input bar: attach ("+", placeholder until image/file attach is built) / text field / send -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/btnAttach"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_input_add"
            android:contentDescription="Attach"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/input_bar_bg"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <EditText
                android:id="@+id/etTask"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:hint="Message the agent..."
                android:textColorHint="#6A6A75"
                android:textColor="#EDEDF2"
                android:minLines="1"
                android:maxLines="5"
                android:inputType="textMultiLine" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnRun"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bubble_user"
            android:src="@android:drawable/ic_menu_send"
            android:contentDescription="Send"
            android:scaleType="center" />
    </LinearLayout>

    <WebView
        android:id="@+id/webViewHidden"
        android:layout_width="1dp"
        android:layout_height="1dp" />
</LinearLayout>
